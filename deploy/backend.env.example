NODE_ENV=production
PORT=3000
TRUST_PROXY=1

# Browser origins allowed to call the API (no custom domain: use your *frontend* CloudFront URL).
# Example: https://d111111abcdef8.cloudfront.net
# VITE_API_URL should point at your *API* CloudFront URL (HTTPS), not http://elastic-ip (mixed content).
ALLOWED_ORIGINS=

# Optional if you set only one origin
# FRONTEND_URL=https://d111111abcdef8.cloudfront.net

# Docker service name for the Python app (do not use localhost here)
PYTHON_SERVICE_URL=http://smart-import:8000

# Persist uploads inside the container mount (see docker-compose volume)
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE=5242880

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public

JWT_SECRET=change-me-long-random-string
JWT_EXPIRES_IN=7d

WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-verify-token

OPENAI_API_KEY=sk-...

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: shown in /health
# SERVICE_VERSION=1.0.0
