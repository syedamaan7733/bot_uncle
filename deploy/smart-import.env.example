OPENAI_API_KEY=sk-...

# Optional Google Vision
# GOOGLE_APPLICATION_CREDENTIALS=/path/in-machine.json (mount file if used)
# GOOGLE_CLOUD_API_KEY=

# Optional Cloudinary (if smart-import crops / uploads)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Fly defaults to shared-cpu-2x / 4gb when LayoutLM/Torch is enabled.
# Use shared-cpu-1x / 2gb if you disable LayoutLM.
# LAYOUT_ENABLED=true
# LAYOUT_WARMUP=true

# See smart-import-service/.env.example for model, layout, and PDF limits.
