OPENAI_API_KEY=your_openai_api_key_here
# Optional: if using Google Vision
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GOOGLE_CLOUD_API_KEY=your_google_api_key

# Optional: LayoutLMv3 layout hints (smart-import OCR path only). Disable to skip entirely.
# LAYOUT_ENABLED=true
# HuggingFace token-classification checkpoint (default: FUNSD-finetuned LayoutLMv3)
# LAYOUT_MODEL_ID=nielsr/layoutlmv3-finetuned-funsd
# Hard cap for layout inference (asyncio.wait_for). Prefer ms for parity with ops tooling.
# LAYOUT_MAX_INFER_MS=45000
# LAYOUT_MAX_INFER_S=45
# Max OCR words forwarded to the layout model / clustering
# LAYOUT_MAX_WORDS=400

# Optional: crop layout image regions and upload per-product images (same Cloudinary as Nest backend).
# CROP_PRODUCT_IMAGES=true
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_CROP_FOLDER=catalog-imports/crops

# Optional: max PDF pages processed per upload (default 20).
# SMART_IMPORT_MAX_PDF_PAGES=20
